# Basic Sudoku Solver

# 0 represents an empty cell
grid = [
    [5, 3, 0, 0, 7, 0, 0, 0, 0],
    [6, 0, 0, 1, 9, 5, 0, 0, 0],
    [0, 9, 8, 0, 0, 0, 0, 6, 0],
    [8, 0, 0, 0, 6, 0, 0, 0, 3],
    [4, 0, 0, 8, 0, 3, 0, 0, 1],
    [7, 0, 0, 0, 2, 0, 0, 0, 6],
    [0, 6, 0, 0, 0, 0, 2, 8, 0],
    [0, 0, 0, 4, 1, 9, 0, 0, 5],
    [0, 0, 0, 0, 8, 0, 0, 7, 9]
]

# Check whether a number is valid
def valid(row, col, num):

    # Check the row
    for j in range(9):
        if grid[row][j] == num:
            return False

    # Check the column
    for i in range(9):
        if grid[i][col] == num:
            return False

    # Find the 3x3 subgrid
    start_row = (row // 3) * 3
    start_col = (col // 3) * 3

    # Check the subgrid
    for i in range(start_row, start_row + 3):
        for j in range(start_col, start_col + 3):
            if grid[i][j] == num:
                return False

    return True


# Solve Sudoku using backtracking
def solve():
    for i in range(9):
        for j in range(9):

            if grid[i][j] == 0:
                for num in range(1, 10):

                    if valid(i, j, num):
                        grid[i][j] = num

                        if solve():
                            return True

                        grid[i][j] = 0

                return False

    return True


# Display the result
if solve():
    print("Solved Sudoku:")
    for row in grid:
        print(row)
else:
    print("No solution exists!")